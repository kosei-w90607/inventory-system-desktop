{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "在庫管理システム",
  "version": "0.1.0",
  "identifier": "com.inventory-system.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "在庫管理システム",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 720,
        "dragDropEnabled": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "upgradeCode": "9a951e09-cc62-5404-be40-7dfe6250fee3",
        "language": "ja-JP"
      }
    }
  }
}
